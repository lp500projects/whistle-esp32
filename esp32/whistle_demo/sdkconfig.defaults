# Board settings as needle_demo (README, Troubleshooting).
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# needle_demo's table with the model partition grown to the end of flash.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
# This board is plugged in by its native USB port (see the README's Whistle
# troubleshooting). The UART bridge default would block every printf.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# LVGL (the screen, ui.c) allocates with malloc, as Waveshare's 1.75C examples set it.
CONFIG_LV_USE_CLIB_MALLOC=y
# Wi-Fi/lwIP and TLS buffers in PSRAM (net.c): internal RAM is scarce once
# Wi-Fi is up, and the screen's 46.6 KB DMA bounce buffers and the engine's
# SRAM scratch (nd_quant.c, nd_model.h) need it.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# One small HTTPS request per clip needs no throughput, so trade Wi-Fi speed
# for internal RAM: Wi-Fi code out of IRAM (+18 KB heap) and 8 static RX
# buffers, not 16 (+12.8 KB).
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=6
